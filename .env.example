# Copie este arquivo para .env e ajuste se necessário.
# O .env é ignorado pelo git; nunca versione credenciais reais.

# Credenciais do banco de dados (usadas pelo contêiner do PostgreSQL e pela API).
POSTGRES_USER=onibus
POSTGRES_PASSWORD=onibus
POSTGRES_DB=onibus

# Porta em que a API fica acessível no seu computador.
# Só mude se a porta 8080 já estiver em uso na sua máquina (ex.: 8081).
API_PORT=8080
